{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "dragonwing",

  "main": "src/index.ts",

  "compatibility_date": "2026-10-04",

  "durable_objects": {
    "bindings": [
      {
        "name": "GAME",
        "class_name": "DragonWingGame"
      },
      {
        "name": "IOT",
        "class_name": "DragonWingIoT"
      },
	  {
		"name": "CHAT",
		"class_name": "DragonWingChat"
	  }
    ]
  },

  "exports": {
    "DragonWingGame": {
      "type": "durable-object",
      "storage": "sqlite"
    },

    "DragonWingIoT": {
      "type": "durable-object",
      "storage": "sqlite"
    },

    "DragonWingChat": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}